# Environment variables for BẠC MÔN HUB Backend
PORT=4000
NODE_ENV=development

# Database (SQLite for local zero-config, or PostgreSQL string)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="bacmonhub_jwt_secret_change_in_production_2026_xyz"
JWT_REFRESH_SECRET="bacmonhub_refresh_secret_change_in_production_2026_xyz"
JWT_EXPIRES_IN="1d"
JWT_REFRESH_EXPIRES_IN="7d"

# Google Gemini API Key (điền API key của bạn vào đây)
GEMINI_API_KEY=""

# MT5 Bridge Secret Token
MT5_BRIDGE_TOKEN="bmh_mt5_secure_bridge_token_2026"

# Desktop App Update Base URL
APP_DOWNLOAD_BASE_URL="http://localhost:4000/updates"
